{
  "expo": {
    "name": "Jetly — Luxury Private Jet Booking",
    "slug": "jetly-flight-booking-rn",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/jet_hero.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a2314"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soumitra69.jetly"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0a2314"
      },
      "package": "com.soumitra69.jetly"
    },
    "web": {
      "favicon": "./assets/plane.png",
      "bundler": "metro"
    }
  }
}
